    "/api/auth/captcha": {
      "get": {
        "tags": [
          "短信验证码登录"
        ],
        "summary": "获取图形验证码",
        "description": "返回 uuid + PNG data URI。发短信前必须先过这一步，否则脚本能拿手机号列表把短信刷爆。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultCaptchaResponse"
                },
                "example": {
                  "code": 200,
                  "message": "ok",
                  "data": {
                    "uuid": "8f2c...",
                    "image": "data:image/png;base64,iVBORw0...",
                    "answer": "A3B7"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/sms/code": {
      "post": {
        "tags": [
          "短信验证码登录"
        ],
        "summary": "发送短信验证码",
        "description": "先取图形验证码，把 uuid 和答案一起带上；同一手机号 60 秒内只能发一次（超了返回 429）。",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "description": "手机号",
            "required": true,
            "schema": {
              "type": "string",
              "example": "13800000001"
            }
          },
          {
            "name": "captchaUuid",
            "in": "query",
            "description": "图形验证码 uuid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "captchaCode",
            "in": "query",
            "description": "图形验证码答案",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "发送成功（演示模式会把验证码写在 message 里）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultString"
                },
                "example": {
                  "code": 200,
                  "message": "ok",
                  "data": "验证码已发送（演示模式，验证码：482913）"
                }
              }
            }
          },
          "400": {
            "description": "没带图形验证码",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 400,
                  "message": "请先获取并填写图形验证码",
                  "data": null
                }
              }
            }
          },
          "429": {
            "description": "发送过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 429,
                  "message": "发送过于频繁，请稍后再试",
                  "data": null
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/sms/login": {
      "post": {
        "tags": [
          "短信验证码登录"
        ],
        "summary": "短信验证码登录",
