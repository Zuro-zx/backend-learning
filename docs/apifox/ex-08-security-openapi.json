{
  "openapi": "3.0.3",
  "info": {
    "title": "08 认证与授权 · 练习接口",
    "description": "Spring Security 7 六条并行过滤器链的练习题接口。\n\n六个账号密码统一 `123456`：\n\n| 账号 | 角色 / 权限点 | 状态 | 用来验证 |\n| --- | --- | --- | --- |\n| alice | ROLE_USER + ARTICLE_DELETE | 正常 | 细粒度权限点 |\n| bob | ROLE_ADMIN + ROLE_AUDITOR | 正常 | 管理员、hasAllRoles 放行 |\n| carol | ROLE_ADMIN | 正常 | hasAllRoles 拒绝（少 AUDITOR） |\n| dave | ROLE_USER | 禁用 | 403 账号已被禁用 |\n| frank | ROLE_USER | 锁定 | 403 账号已被锁定 |\n| erin | ROLE_AUDITOR | 正常 | hasAnyRole 放行 |\n\n**注意鉴权方式按链不同**：`/stage1` `/stage2` `/stage3` 是 httpBasic，`/stage5` 和 `/api/**` 才读 Bearer token，`/stage4` 是 Cookie 会话 + CSRF。",
    "version": "1.0.0",
    "contact": {
      "name": "zsj",
      "email": "1370195289@qq.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8008",
      "description": "本地开发"
    }
  ],
  "tags": [
    {
      "name": "认证（密码 + JWT）",
      "description": "登录 / me / 登出 / 改密"
    },
    {
      "name": "短信验证码登录",
      "description": "图形验证码 → 发码 → 换 token"
    },
    {
      "name": "业务接口（权限点 / @PreAuthorize）",
      "description": "链上规则 + 方法级注解"
    },
    {
      "name": "阶段演示（过滤器链）",
      "description": "stage1 ~ stage5 各条链的行为差异"
    },
    {
      "name": "表单登录（Session + CSRF）",
      "description": "stage4：Cookie 会话 + CSRF token"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "认证（密码 + JWT）"
        ],
        "summary": "密码登录",
        "description": "校验通过后签发 JWT，jti 写入白名单（Redis），同一账号再次登录会把上一个 token 踢下线。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "alice",
                "password": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultLoginResponse"
                },
                "example": {
                  "code": 200,
                  "message": "ok",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiJ9...",
                    "tokenType": "Bearer",
                    "expiresIn": 7200,
                    "username": "alice",
                    "authorities": [
                      "ARTICLE_DELETE",
                      "ROLE_USER",
                      "FACTOR_PASSWORD"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 400,
                  "message": "参数错误",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "用户名或密码错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 401,
                  "message": "用户名或密码错误",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "账号禁用 / 锁定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 403,
                  "message": "账号已被锁定",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "认证（密码 + JWT）"
        ],
        "summary": "当前登录用户",
        "description": "把 token 里的身份回显给前端，刷新页面后用它恢复登录态。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultUserInfo"
                },
                "example": {
                  "code": 200,
                  "message": "ok",
                  "data": {
                    "username": "alice",
                    "authorities": [
                      "ARTICLE_DELETE",
                      "ROLE_USER",
                      "FACTOR_PASSWORD"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录 / token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 401,
                  "message": "未登录或登录已过期",
                  "data": null
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
