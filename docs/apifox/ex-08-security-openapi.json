  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名",
            "example": "alice"
          },
          "password": {
            "type": "string",
            "description": "密码",
            "example": "123456"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT，放在 Authorization: Bearer 后面"
          },
          "tokenType": {
            "type": "string",
            "description": "固定 Bearer",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "description": "有效期（秒）",
            "example": 7200
          },
          "username": {
            "type": "string"
          },
          "authorities": {
            "type": "array",
            "description": "权限列表，角色带 ROLE_ 前缀",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "token": "eyJhbGciOiJIUzI1NiJ9...",
          "tokenType": "Bearer",
          "expiresIn": 7200,
          "username": "alice",
          "authorities": [
            "ARTICLE_DELETE",
            "ROLE_USER",
            "FACTOR_PASSWORD"
          ]
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "authorities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "username": "alice",
          "authorities": [
            "ARTICLE_DELETE",
            "ROLE_USER",
            "FACTOR_PASSWORD"
          ]
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "原密码",
            "example": "123456"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码，6~32 位",
            "example": "654321"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ]
      },
      "SmsLoginRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号",
            "example": "13800000001"
          },
          "code": {
            "type": "string",
            "description": "6 位数字验证码",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "CaptchaResponse": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "提交时回传的 captchaUuid"
          },
          "image": {
            "type": "string",
            "description": "PNG 的 data URI，直接塞进 <img src>"
          },
          "answer": {
            "type": "string",
            "description": "演示模式才返回答案，生产环境应置空"
          }
        },
        "example": {
          "uuid": "8f2c...",
          "image": "data:image/png;base64,iVBORw0...",
          "answer": "A3B7"
        }
      },
      "ResultLoginResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/LoginResponse"
          }
        }
      },
      "ResultUserInfo": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ResultCaptchaResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CaptchaResponse"
          }
        }
      },
      "ResultString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ResultMap": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}