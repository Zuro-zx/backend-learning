                "example": {
                  "code": 200,
                  "message": "ok",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "未登录 / token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMap"
                },
                "example": {
                  "code": 401,
                  "message": "未登录或登录已过期",
                  "data": null
